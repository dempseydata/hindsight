    { "dot": "rose", "title": "The one outbound path", "items": ["Only the nightly run leaves the machine: claude -p under the operator's subscription", "The child gets --tools \"\", --strict-mcp-config and disableAllHooks, from an empty cwd", "Both servers bind 127.0.0.1; Python makes no other network call"] },
    { "dot": "cyan", "title": "Who runs when", "items": ["Hooks fire per session; capture is async, the health check is sync with a 5 s cap", "launchd keeps the listener alive and starts the nightly run at 03:00", "The views server runs only after ops serve or open, with no plist"] },
    { "dot": "slate", "title": "Left out", "items": ["The nightly sweep also re-reads transcripts to catch missed hook firings", "Backstop, sunk-cost scan and the how view's git log reads are not drawn", "OTel export is opt-in, set in Claude Code's own settings"] }
